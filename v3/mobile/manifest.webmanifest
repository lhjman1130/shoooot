{
  "name": "shoooot 3",
  "short_name": "shoooot3",
  "description": "영감이 오면, 그냥 슛.",
  "id": "/shoooot/v3/",
  "start_url": "../shooot-app.html",
  "scope": "../",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F2FE",
  "theme_color": "#7B5BE0",
  "lang": "ko",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "../shooot-app.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}